# No Brand Baseball - iOS release automation (runs on GitHub's macOS runners, no Mac needed).
#
#   bundle exec fastlane setup   one time: App ID + App Store Connect record + signing certs
#   bundle exec fastlane beta    build, sign, upload to TestFlight (and then App Store review)
#
# Everything is driven by environment variables set from GitHub Actions secrets; see README.

default_platform(:ios)

APP_ID = "com.nobrandbaseball.app"
CERTS_REPO = ENV.fetch("MATCH_GIT_URL", "https://github.com/sicher19-dev/No-Brand-Certificates.git")
CERTS_USER = ENV.fetch("MATCH_GIT_USER", "sicher19-dev")

# Accepts ASC_KEY_CONTENT either as the raw .p8 text or as base64 of the file, and fails
# with a readable message (never printing the key) when the secret is not a valid key.
def asc_key_pem
  raw = ENV.fetch("ASC_KEY_CONTENT").strip
  pem = raw.start_with?("-----BEGIN") ? raw : (Base64.decode64(raw) rescue "")
  pem = pem.gsub("\r", "")
  unless pem.include?("-----BEGIN PRIVATE KEY-----") && pem.include?("-----END PRIVATE KEY-----")
    UI.user_error!("ASC_KEY_CONTENT is not a valid App Store Connect .p8 key (got #{raw.length} characters, " \
                   "starts with '#{raw[0, 4]}'). Re-add the secret: base64 of the AuthKey_XXXX.p8 file, or the file's text.")
  end
  begin
    OpenSSL::PKey.read(pem)
  rescue => e
    UI.user_error!("ASC_KEY_CONTENT decodes to PEM text but OpenSSL cannot read it (#{e.class}). Re-download the key from App Store Connect.")
  end
  pem
end

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").strip,
    key_content: asc_key_pem,
    is_key_content_base64: false,
    in_house: false
  )
end

def certs_auth
  Base64.strict_encode64("#{CERTS_USER}:#{ENV.fetch('MATCH_GIT_TOKEN')}")
end

def sync_certs(key, readonly:)
  match(
    type: "appstore",
    readonly: readonly,
    api_key: key,
    app_identifier: APP_ID,
    team_id: ENV.fetch("APPLE_TEAM_ID"),
    git_url: CERTS_REPO,
    git_basic_authorization: certs_auth,
    git_branch: "main",
    platform: "ios"
  )
end

platform :ios do
  desc "One-time setup: register the bundle ID, create the App Store Connect app record, and create the distribution certificate + profile in the certs repo"
  lane :setup do
    setup_ci
    ENV["MATCH_READONLY"] = "false" # setup_ci forces readonly; this lane must be allowed to create certs
    key = asc_key # also authenticates Spaceship::ConnectAPI for the direct calls below
    app_name = ENV.fetch("APP_NAME", "No Brand Baseball")

    # 1. Bundle ID in the developer portal (idempotent)
    if Spaceship::ConnectAPI::BundleId.find(APP_ID)
      UI.message("Bundle ID #{APP_ID} is already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "No Brand Baseball", identifier: APP_ID, platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS)
      UI.success("Registered bundle ID #{APP_ID}")
    end

    # 2. App record in App Store Connect. Apple's API does not allow creating apps, so this is a
    #    one-time manual step: App Store Connect -> My Apps -> (+) New App -> iOS, name, bundle ID
    #    com.nobrandbaseball.app, SKU nobrandbaseball-ios. We only check for it here.
    existing = Spaceship::ConnectAPI::App.find(APP_ID)
    if existing
      UI.success("App Store Connect record found: '#{existing.name}'")
    else
      UI.important("No App Store Connect app record for #{APP_ID} yet. Create it by hand (My Apps -> + -> New App, " \
                   "name '#{app_name}', bundle ID #{APP_ID}). Certificates are created regardless; TestFlight uploads need the record.")
    end

    # 3. Distribution certificate + App Store provisioning profile, stored encrypted in the certs repo
    sync_certs(key, readonly: false)
    UI.success("Signing is set up. Push a tag like v1.0.0 (or run the iOS workflow) to ship a build to TestFlight.")
  end

  desc "Build, sign and upload to TestFlight"
  lane :beta do
    setup_ci
    key = asc_key
    sync_certs(key, readonly: true)

    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    version = ENV.fetch("APP_VERSION", "1.0.0")

    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: profile
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile } },
      output_directory: "build",
      output_name: "NoBrandBaseball.ipa",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} -skipPackagePluginValidation -skipMacroValidation",
      silent: true
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("RELEASE_NOTES", "New No Brand Baseball build #{version} (#{build_number})")
    )
    UI.success("Uploaded #{version} (#{build_number}) to TestFlight.")
  end

  desc "Invite TestFlight testers (TESTER_EMAIL, or store/testers.txt) to the external group"
  lane :testers do
    asc_key # authenticates Spaceship::ConnectAPI
    group_name = ENV.fetch("TESTER_GROUP", "No Brand Pitchers")

    wanted = []
    if ENV["TESTER_EMAIL"].to_s.strip != ""
      wanted << [ENV["TESTER_EMAIL"].strip.downcase, ENV["TESTER_NAME"].to_s.strip]
    else
      file = ENV.fetch("TESTERS_FILE", File.expand_path("../../../store/testers.txt", __dir__))
      File.readlines(file).each do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#")
        email, name = line.split(",", 2).map { |x| x.to_s.strip }
        wanted << [email.downcase, name.to_s] if email.include?("@")
      end
    end
    UI.user_error!("No testers to invite: run the workflow with an email, or list testers in store/testers.txt") if wanted.empty?

    app = Spaceship::ConnectAPI::App.find(APP_ID) || UI.user_error!("No App Store Connect app for #{APP_ID}")
    group = app.get_beta_groups.find { |g| g.name == group_name }
    UI.user_error!("No TestFlight group named '#{group_name}'") unless group

    existing = Spaceship::ConnectAPI::BetaTester.all(filter: { betaGroups: group.id }).map { |t| t.email.to_s.downcase }
    missing = wanted.reject { |email, _| existing.include?(email) }
    if missing.empty?
      UI.success("All #{wanted.length} tester(s) are already in '#{group_name}'.")
    else
      payload = missing.map do |email, name|
        first, last = name.split(" ", 2)
        { email: email, firstName: first.to_s, lastName: last.to_s }
      end
      group.post_bulk_beta_tester_assignments(beta_testers: payload)
      missing.each { |email, _| UI.success("Invited #{email.sub(/^(.).*@/, '\1***@')} to '#{group_name}'") }
    end

    # Where the builds stand: testers only get their email once a build is approved for the group.
    builds = app.get_builds(includes: "buildBetaDetail,preReleaseVersion", sort: "-uploadedDate", limit: 6)
    builds.each do |b|
      v = (b.respond_to?(:pre_release_version) && b.pre_release_version) ? b.pre_release_version.version : "?"
      ext = (b.respond_to?(:build_beta_detail) && b.build_beta_detail) ? b.build_beta_detail.external_build_state : "?"
      UI.message("Build #{v} (#{b.version}): #{b.processing_state}, external: #{ext}")
    end
  end
end
